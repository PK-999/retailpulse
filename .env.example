RETAILPULSE_DATA_DIR=./data
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_ENABLED=false
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=180

# Optional attended Azure Gold refresh. Fill these from your deployment and export them.
# The application does not automatically load .env files. Never commit a real token.
RETAILPULSE_DATABRICKS_HOST=
RETAILPULSE_DATABRICKS_WAREHOUSE_ID=
RETAILPULSE_DBT_CATALOG=
RETAILPULSE_DBT_SCHEMA=retailpulse_gold
RETAILPULSE_DBT_SOURCE_SCHEMA=retailpulse_silver
DATABRICKS_TOKEN=
